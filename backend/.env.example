FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-secret
JWT_SECRET_KEY=change-me-to-a-long-random-jwt-secret

# MySQL connection (edit with your credentials)
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=schedule_crusher

# Test database (used by pytest)
MYSQL_TEST_DATABASE=schedule_crusher_test

# Or set a full URL instead of the MYSQL_* vars above:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/schedule_crusher
